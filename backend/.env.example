FLASK_APP=run.py
FLASK_ENV=development

# Secrets: use long random strings.
SECRET_KEY=
JWT_SECRET_KEY=

# PostgreSQL connection. Either set DATABASE_URL, or the five DB_* values.
# DATABASE_URL=postgresql://user:password@localhost:5432/phishsimulator_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=phishsimulator_db
DB_USER=
DB_PASSWORD=

# Where the app is reached (used for CORS and links).
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000
# The backend URL that campaign emails point to. For a real device to open the
# tracking link and pixel, this must be reachable from that device (for a demo,
# a tunnel such as ngrok, e.g. https://abc123.ngrok-free.app).
PUBLIC_BACKEND_URL=http://localhost:5000

# Gmail sending for password resets and phishing campaigns.
# Use a Gmail App Password (Google account > Security > App passwords), not your
# normal password. Leave blank to disable sending.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Safety allow-list: campaigns can ONLY be sent to these addresses. Use your own
# inboxes. "*" is a wildcard, so a Gmail plus-alias pattern lets you send to any
# alias of your own address. Comma-separated.
# CAMPAIGN_ALLOWED_RECIPIENTS=you@gmail.com,you+*@gmail.com
CAMPAIGN_ALLOWED_RECIPIENTS=
# Minutes after sending with no click or report before a recipient counts as "ignored"
CAMPAIGN_IGNORE_MINUTES=10
# Hours ahead of UTC for "days" (streaks, daily goal, calendar, charts, date filters). South Africa = 2
APP_UTC_OFFSET_HOURS=2

# Logins (server-side sessions in the user_session table, tokens in HttpOnly cookies).
# Signed out after SESSION_IDLE_MINUTES without activity and after SESSION_MAX_HOURS in any case.
SESSION_IDLE_MINUTES=30
SESSION_MAX_HOURS=12
ACCESS_TOKEN_MINUTES=10
# Local development (no proxy). Docker sets these from the root .env.
COOKIE_SECURE=true
TRUSTED_PROXY_COUNT=0

# Demo data: auto = load once into an empty database then keep it, reset = reseed
# on every start, off = never seed.
SEED_DEMO=auto
# The admin sign-in the demo seed creates.
ADMIN_EMAIL=admin@phishsimulator.com
ADMIN_PASSWORD=Admin#2026
# Password for every seeded test player.
DEMO_PASSWORD=Player#2026
# Your own Gmail address. Test players get plus-aliases of it (you+lerato.mokoena@gmail.com), which
# all arrive in your inbox, so campaigns can be demonstrated. Also add "you+*@gmail.com" to
# CAMPAIGN_ALLOWED_RECIPIENTS. Left blank, test players get fake @phishsimulator.test addresses.
DEMO_EMAIL=
# Set this only if you want the seed to create a player for your own address.
# Left blank, you register yourself in the app.
OWNER_EMAIL=
# The two dataset files every demo scenario comes from, inside DEMO_DATASET_DIR (by default
# backend/uploads/datasets; Docker mounts DEMO_DATASETS_HOST_DIR from the root .env there). The seed
# imports them like an upload, replays an admin review, and players only practise on those scenarios.
# DEMO_DATASET_DIR=
DEMO_EMAIL_DATASET=email/phishing_legit_dataset_KD_10000.csv
DEMO_SMS_DATASET=sms/Combined-Labeled-Dataset.csv
# Also load the admin's custom scenarios (on): backend/demo/admin_custom_scenarios.json, South African phishing
# and genuine messages with links and attachments. They are most of what players see; only a few balanced
# pairs per category go live from the datasets. off = the public datasets only (more of their drafts go live),
# for figures that must come from them alone (as reported in the paper).
DEMO_AUTHOR_WRITTEN=on
