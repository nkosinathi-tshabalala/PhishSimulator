# Keeps secrets, local data and generated files out of git.
# .githooks/pre-commit double-checks every commit (enable it once, see README).

# Secrets: every .env file except the .example templates, and key files
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx

# Uploaded datasets and database dumps stay on your machine
backend/uploads/
*.db
*.sqlite3
*.dump

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.coverage

# Node
node_modules/
dist/
coverage/
*.tsbuildinfo

# Editors and OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Logs
*.log
