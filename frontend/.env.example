# The page calls /api on its own address; in development Vite passes it to Flask (vite.config.ts),
# in Docker nginx does. Keeping one address makes the HttpOnly login cookies first-party.
VITE_API_URL=/api
# Where the Vite dev proxy sends /api (local development only)
VITE_DEV_API_TARGET=http://127.0.0.1:5000
