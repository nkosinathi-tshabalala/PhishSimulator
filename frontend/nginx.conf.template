# Serves the built React app and forwards /api to the backend container.
# The nginx image fills in ${MAX_UPLOAD_MB} and ${REQUEST_TIMEOUT_SECONDS} from the environment when the container starts.
server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Do not advertise the nginx version
    server_tokens off;
    # Dataset uploads pass through here, so allow the same size as the API
    client_max_body_size ${MAX_UPLOAD_MB}m;

    # Send API calls to the backend container.
    location /api/ {
        proxy_pass http://backend:5000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Large dataset imports can take minutes; wait as long as the API is allowed to work
        proxy_read_timeout ${REQUEST_TIMEOUT_SECONDS}s;
        proxy_send_timeout ${REQUEST_TIMEOUT_SECONDS}s;
    }

    # Built JavaScript and CSS have a content hash in their names, so a new build always gets new
    # file names. Browsers can keep these for a year without ever showing an old version.
    location /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header X-Content-Type-Options "nosniff" always;
    }

    # Single-page app: unknown paths (like /caught or /reset-password) return index.html.
    # The API adds its own security headers, so these are only for the page.
    location / {
        try_files $uri $uri/ /index.html;

        # The page itself is checked with the server on every visit, so a rebuilt app shows at once
        add_header Cache-Control "no-cache" always;

        # Browser protections. The CSP lets the page load code only from this site (fonts from Google),
        # which limits the damage any injected script could do.
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    }
}
