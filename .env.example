# Settings for "docker compose". Copy this file to .env (next to docker-compose.yml);
# Compose reads it automatically. App secrets, Gmail, the campaign allow-list and the
# demo sign-ins live in backend/.env instead.

# PostgreSQL, shared by the db and backend containers. The database is created with
# these on first start only; after changing them run "docker compose down -v".
DB_NAME=phishsimulator_db
DB_USER=phish
DB_PASSWORD=change-me

# Which network address the app (frontend port) listens on. 127.0.0.1 = only this computer (safest).
# Use 0.0.0.0 to let other devices on your network open the app. The API port always stays on this computer.
HOST_IP=127.0.0.1

# Ports opened on your machine.
FRONTEND_PORT=8080
BACKEND_PORT=5000

# Where the browser reaches the app (CORS and links). Keep the ports in step with the
# ones above. PUBLIC_BACKEND_URL is what campaign emails link to, so open those emails
# on this computer.
FRONTEND_URL=http://localhost:8080
BACKEND_URL=http://localhost:5000
PUBLIC_BACKEND_URL=http://localhost:5000

# API path the built frontend calls. nginx forwards it to the backend container.
VITE_API_URL=/api

# Largest dataset file you can upload, in MB (used by the API and by nginx). CEAS_08.csv is about 68 MB.
MAX_UPLOAD_MB=120
# How long one request may run, in seconds (Gunicorn and nginx). Importing a 40,000-row dataset takes a
# minute or two; 600 leaves room for the largest public corpora.
REQUEST_TIMEOUT_SECONDS=600

# The folder on this computer that holds the demo's dataset files (mounted read-only into the backend).
# The seed imports DEMO_EMAIL_DATASET and DEMO_SMS_DATASET (set in backend/.env) from it.
DEMO_DATASETS_HOST_DIR=./backend/uploads/datasets

# Login cookies. true = sent only over HTTPS or to localhost (browsers treat http://localhost as secure).
# Set false only to open the app over plain http from another device (e.g. http://192.168.x.x:8080).
COOKIE_SECURE=true
